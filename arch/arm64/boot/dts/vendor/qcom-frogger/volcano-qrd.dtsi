	gpio_board_id {
		compatible = "gpio,board-id,Frogger";
		board_id_gpio0 = <&tlmm 57 0>;
		board_id_gpio1 = <&tlmm 58 0>;
		board_id_gpio2 = <&tlmm 65 0>;
