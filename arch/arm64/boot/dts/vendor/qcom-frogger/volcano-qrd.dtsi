#include <dt-bindings/gpio/gpio.h>
#include "volcano-pmiv0104.dtsi"
#include "volcano-thermal-overlay.dtsi"
#include <dt-bindings/clock/qcom,rpmh.h>

&soc {
//#ifdef NT_EDIT
//Nothing/add for Factory RF cable detect/ARCA-257
	cable_detect {
		compatible = "nt,cable_detect";
		ant0_present = <&tlmm 34 0x00>;
		ant2_present = <&tlmm 35 0x00>;
	};
//#endif /* NT_EDIT */

//#ifdef NT_EDIT
//Nothing/add for factory sim slot detect/ARCA-489
	slot_detect {
		compatible = "nt,slot_detect";
		uim0_present = <&tlmm 99 0x00>;
		uim1_present = <&tlmm 103 0x00>;
		//#ifdef NT_EDIT
		cd-gpios = <&tlmm 99 GPIO_ACTIVE_HIGH>;
		//#endif
	};
//#endif /* NT_EDIT */

//#ifdef NT_EDIT
//Nothing/Add for file node control ois vdd/ARCA-524
	ois_vdd_ctrl {
		compatible = "nt,ois_vdd_ctrl";
		ois-vdd-supply = <&WL_LDO6>;
		ois-vdd-max-uv = <3004000>;
		ois-vdd-min-uv = <3004000>;
	};
//#endif /* NT_EDIT */
};


&tlmm {
	cable_gpio_default: cable_gpio_default {
		mux {
			pins = "gpio34","gpio35";
			function = "gpio";
		};

		config {
			pins = "gpio34","gpio35";
			bias-pull-up;
			input-enable;
		};
	};
};
&soc {
	cable_gpioi: cable_gpio {
		compatible = "gpio,cable_state";
		cable-gpio-ant0 = <&tlmm 34 0>;
		cable-gpio-ant2 = <&tlmm 35 0>;
		pinctrl-names = "default";
		pinctrl-0 = <&cable_gpio_default>;
		status = "okay";
	};
};


&ufsphy_mem {
	compatible = "qcom,ufs-phy-qmp-v4-crow";

	/* VDDA_UFS_CORE */
	vdda-phy-supply = <&L2B>;
	vdda-phy-max-microamp = <140120>;

	/* VDDA_UFS_0_1P2 */
	vdda-pll-supply = <&L4B>;
	vdda-pll-max-microamp = <18340>;

	/* Phy GDSC for VDD_MX, always on */
	vdd-phy-gdsc-supply = <&gcc_ufs_mem_phy_gdsc>;

	/* Qref power supply, Refer Qref diagram */
	vdda-qref-supply = <&L2B>;
	vdda-qref-max-microamp = <2310>;

	status = "ok";
};

&ufshc_mem {
	vdd-hba-supply = <&gcc_ufs_phy_gdsc>;

	vcc-supply = <&L12B>;
	vcc-max-microamp = <800000>;
	vccq-supply = <&L5F>;
	vccq-max-microamp = <750000>;
	vccq2-supply = <&L4F>;
	vccq2-max-microamp = <750000>;

	/* VDD_PX10 is voted for the ufs_reset_n */
	qcom,vddp-ref-clk-supply = <&L5B>;
	qcom,vddp-ref-clk-max-microamp = <100>;

	qcom,vccq-parent-supply = <&S2B>;
	qcom,vccq-parent-max-microamp = <210000>;

	status = "ok";
};

&sdhc_2 {
	status = "disabled";

	vdd-supply = <&L13B>;
	qcom,vdd-voltage-level = <2960000 2960000>;
	qcom,vdd-current-level = <0 800000>;

	vdd-io-supply = <&L23B>;
	qcom,vdd-io-voltage-level = <1800000 2960000>;
	qcom,vdd-io-current-level = <0 22000>;

	pinctrl-names = "default", "sleep";
	pinctrl-0 = <&sdc2_on>;
	pinctrl-1 = <&sdc2_off>;

	cd-gpios = <&tlmm 65 GPIO_ACTIVE_LOW>;
};

&pmiv0104_lcdb {
	status = "disabled";
};

&pmiv0104_wled {
	status = "disabled";
};

//#ifdef NT_EDIT
/* Nothing BELL-106:Ieffaa4 modify Psensor LEDA VDD 3.3V */
&pm7550_l16{
        regulator-min-microvolt = <3300000>;
        regulator-max-microvolt = <3300000>;
        qcom,init-voltage = <3300000>;
};
//#endif NT_EDIT
//#ifdef NT_EDIT
/*Nothing ARCA-394:ft3683g TP bring up*/
&pm7550_l22{
	regulator-min-microvolt = <3300000>;
	regulator-max-microvolt = <3300000>;
	qcom,init-voltage = <3300000>;
};
//#endif NT_EDIT

&qupv3_se0_spi {
	#address-cells = <1>;
	#size-cells = <0>;

	status = "ok";
	/*NT_EDIT ARCA-6:focal-3681 TP bring up*/
	focaltech@0 {
		compatible = "focaltech,fts_ts";
		reg = <0x0>;
		spi-max-frequency = <12000000>;
		interrupt-parent = <&tlmm>;
		interrupts = <19 0x2008>;
		focaltech,reset-gpio = <&tlmm 20 0x00>;
		focaltech,irq-gpio = <&tlmm 19 0x2008>;
		focaltech,max-touch-number = <10>;
		focaltech,display-coords =  <0 0 1224 2720>;
		vci-supply = <&L22B>;
		vddio-supply = <&L11B>;
		status = "ok";
	};
};

//#ifdef NT_EDIT
/*Nothing ARCA-11:aac-6010 haptic bring up*/
&tlmm {
	ics_haptic_rst_pinctrl: ics_haptic_rst_pinctrl {
		mux {
			pins = "gpio138";
			function = "gpio";
		};
		config {
			pins = "gpio138";
			drive-strength = <2>;
			bias-disable;
			output-high;
		};
	};

	ics_haptic_irq_pinctrl: ics_haptic_irq_pinctrl {
		mux {
			pins = "gpio143";
			function = "gpio";
		};
		config {
			pins = "gpio143";
			bias-pull-up;
			input-enable;
			drive-open-drain;
			//power-source = <0>;
		};
	};
};

&qupv3_se8_i2c {
	#address-cells = <1>;
	#size-cells = <0>;
	qcom,clk-freq-out = <1000000>;
	status = "ok";

	ics_haptic_top: ics_haptic@5f {
		compatible = "ics,haptic_rt";
		reg = <0x5f>;
		device-name = "vibrator_nt";
		richtap-name = "aac_richtap";
		pinctrl-names = "default";
		pinctrl-0 = <&ics_haptic_rst_pinctrl &ics_haptic_irq_pinctrl>;
		reset-gpio = <&tlmm 138 0>;
		irq-gpio = <&tlmm 143 0>;
		// rt6010 chip configuration
		rt6010_chip_id = <0x6B>;
		rt6010_reg_size = <0x6C>;
		rt6010_ram_size = <0x600>;
		rt6010_sys_f0 = <1700>;
		rt6010_list_base_addr = <0x400>;
		rt6010_wave_base_addr = <0x420>;
		rt6010_fifo_ae = <0x200>;
		rt6010_fifo_af = <0x300>;
		rt6010_boost_mode = <0x00>;
		rt6010_boost_vol = <0x0A>;
		rt6010_gain = <0x80>;
		rt6010_brake_en = <0>;
		rt6010_brake_wave_no = <0>;
		rt6010_brake_const = <0>;
		rt6010_brake_acq_point = <0>;
		status = "ok";
	};

};
//#endif NT_EDIT

//#ifdef NT_EDIT
/*Nothing / add for fingerprint function / ARCA-7*/
&qupv3_se2_spi {
	status = "ok";
};

&soc {
	goodix_fp {
		compatible = "goodix,fingerprint";
		interrupt-parent = <&tlmm>;
		vdd-supply = <&L23B>;
		vdd-max-uv = <3000000>;
		vdd-min-uv = <3000000>;
		fp-gpio-irq = <&tlmm 75 0x00>;
		fp-gpio-reset = <&tlmm 76 0x00>;
		status = "ok";
	};
};
//#endif NT_EDIT

//#ifdef NT_EDIT
/*Nothing / add for nfc function / ARCA-21*/
&qupv3_se1_i2c {
	status = "ok";
	st_st21nfc@08 {
		compatible = "st,st21nfc";
		reg = <0x08>;
		interrupt-parent = <&tlmm>;
		interrupts = <31 0>;
		reset-gpios = <&tlmm 7 0>;
		irq-gpios = <&tlmm 31 0>;
		//pidle-gpios = <&tlmm xx 0>;
		clkreq-gpios = <&tlmm 6 0>;
		clocks = <&rpmhcc RPMH_LN_BB_CLK2>;
		clock-names = "nfc_ref_clk";
		st,clk_pinctrl;
		status = "ok";
	};
};
//#endif NT_EDIT

//#BELL-423,zhanghao,20250714,NFC,begin
// add st54spi_gpio dts
&soc {
	st54spi_gpio {
		status = "ok";
		compatible = "st,st54spi_gpio";
		/* gpio used as SE_nRESET */
		gpio-power_nreset = <&tlmm 14 0x00>;
	};
};
//#BELL-423,zhanghao,20250714,NFC,end

/*Nothing/add for LED function/ARCA-18*/
&qupv3_se7_i2c {
	status = "ok";
	aw20036_led@3a {
		compatible = "awinic,aw20036_led";
		reg = <0x3a>;
		irq-gpio = <&tlmm 52 0>;
		reset-gpio = <&tlmm 54 0>;
		aw20036,led {
			aw20036,name = "aw20036_led";
			aw20036,imax = <1>;
			aw20036,brightness = <128>;
			aw20036,max_brightness = <255>;
		};
	};
};

/*Nothing add for chg_data_id device node/ARCA-121*/
&battery_charger {
	chg_data_id = <8>;
	nt_low-power-off-soc0-vbat = <3300>;
};
//#endif NT_EDIT

&L1B {
	status = "disabled";
};

