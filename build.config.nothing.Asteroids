TARGET_PRODUCT=Asteroids
NT_PROJECT=Asteroids
echo "!!! build.config.nothing.Asteroids: TARGET_PRODUCT=${TARGET_PRODUCT} !!!"
echo "!!! build.config.nothing.Asteroids: NT_PROJECT=${NT_PROJECT} !!!"
apply_defconfig_fragment ${KERNEL_DIR}/arch/${ARCH}/configs/vendor/${TARGET_PRODUCT}.config

echo "!!! add  -DNT_PROJECT=${TARGET_PRODUCT}"
export KBUILD_CFLAGS+=" -DNT_PROJECT=${TARGET_PRODUCT}"
